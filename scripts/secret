#!/bin/bash
# Manage agent secrets in the macOS login Keychain.
# Secret values are never printed and never passed as command-line arguments.
set -euo pipefail

PREFIX="agent-secrets/"
ACCOUNT="${USER:-$(id -un)}"

die() { echo "error: $*" >&2; exit 1; }

check_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid name '$1' (letters, digits, . _ - only)"
}

usage() {
  cat >&2 <<'EOF'
usage:
  secret store NAME      prompt for a value (hidden) and store it
  secret list            list stored secret names
  secret exists NAME     exit 0 if NAME is stored
  secret delete NAME     remove NAME
  secret audit FILE      list keys found in a .env file (no values)
  secret import FILE     store every key of a .env file in Keychain
EOF
  exit 2
}

# Store a value through `security -i` (stdin), so it never appears in argv.
# Values containing " \ or newlines are refused: store those with `secret store`.
store_value() {
  local name="$1" value="$2"
  case "$value" in
    *'"'*|*'\'*|*$'\n'*) return 1 ;;
  esac
  printf 'add-generic-password -U -T "" -a "%s" -s "%s%s" -w "%s"\n' \
    "$ACCOUNT" "$PREFIX" "$name" "$value" | security -i >/dev/null
}

# Read KEY=VALUE lines of a .env file; calls "$1 KEY VALUE" for each.
each_env_entry() {
  local cb="$1" file="$2" line key value
  [ -f "$file" ] || die "file not found: $file"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"          # trim leading spaces
    [ -z "$line" ] && continue
    [ "${line:0:1}" = "#" ] && continue
    line="${line#export }"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"; value="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"            # trim trailing spaces
    if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    "$cb" "$key" "$value"
  done < "$file"
}

audit_entry() {
  if [ -n "$2" ]; then echo "$1  (value present)"; else echo "$1  (empty)"; fi
}

import_entry() {
  local key="$1" value="$2"
  if ! [[ "$key" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "skipped $key: invalid name" >&2; return 0
  fi
  if [ -z "$value" ]; then
    echo "skipped $key: empty value" >&2; return 0
  fi
  if store_value "$key" "$value"; then
    echo "stored  $key"
  else
    echo "skipped $key: contains special characters, run: secret store $key" >&2
  fi
}

cmd="${1:-}"; [ -n "$cmd" ] || usage; shift

case "$cmd" in
  store)
    [ $# -eq 1 ] || usage; check_name "$1"
    # With no value after -w, `security` prompts on the terminal (hidden input).
    security add-generic-password -U -T "" -a "$ACCOUNT" -s "$PREFIX$1" -w
    echo "stored $1"
    ;;
  list)
    # dump-keychain without -d prints attributes only, never secret data.
    security dump-keychain 2>/dev/null \
      | sed -n "s/.*\"svce\"<blob>=\"${PREFIX//\//\\/}\([^\"]*\)\".*/\1/p" | sort -u
    ;;
  exists)
    [ $# -eq 1 ] || usage; check_name "$1"
    security find-generic-password -a "$ACCOUNT" -s "$PREFIX$1" >/dev/null 2>&1
    ;;
  delete)
    [ $# -eq 1 ] || usage; check_name "$1"
    security delete-generic-password -a "$ACCOUNT" -s "$PREFIX$1" >/dev/null
    echo "deleted $1"
    ;;
  audit)
    [ $# -eq 1 ] || usage
    each_env_entry audit_entry "$1"
    ;;
  import)
    [ $# -eq 1 ] || usage
    each_env_entry import_entry "$1"
    echo "done. Now delete $1 and check that .env* is in .gitignore."
    ;;
  *) usage ;;
esac
