#!/bin/bash
# Run one command with secrets from the macOS Keychain injected as
# environment variables of that command only. Values are never printed.
#
#   with-secrets OPENAI_API_KEY=openai -- python app.py
set -euo pipefail

PREFIX="agent-secrets/"
ACCOUNT="${USER:-$(id -un)}"

usage() {
  echo "usage: with-secrets VAR=name [VAR=name ...] -- command [args...]" >&2
  exit 2
}

pairs=()
count=0
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  pairs+=("$1"); count=$((count + 1)); shift
done
[ "$count" -gt 0 ] || usage
[ "${1:-}" = "--" ] || usage
shift
[ $# -gt 0 ] || usage

for p in "${pairs[@]}"; do
  var="${p%%=*}"
  name="${p#*=}"
  if [ "$var" = "$p" ] || ! [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
     || ! [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "error: bad mapping '$p' (expected VAR=name)" >&2
    exit 2
  fi
  if ! val="$(security find-generic-password -a "$ACCOUNT" -s "$PREFIX$name" -w 2>/dev/null)"; then
    echo "error: secret '$name' not found or access denied" >&2
    exit 1
  fi
  export "$var=$val"
done
unset val

exec "$@"
